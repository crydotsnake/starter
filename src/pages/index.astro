---
import { defaultLocale, localeConfig, localePath, getTranslations } from '../i18n/utils';

const t = getTranslations(defaultLocale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const defaultPath = localePath(defaultLocale);
const localeMatchers = localeConfig.map((locale) => ({
  match: locale.match,
  path: localePath(locale.code),
}));
---

<!doctype html>
<html lang={defaultLocale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <link rel="icon" href={`${base}/images/favicon.ico`} sizes="48x48" />
  <link rel="icon" href={`${base}/images/favicon.png`} type="image/png" sizes="96x96" />
  <link rel="apple-touch-icon" href={`${base}/images/apple-touch-icon.png`} />
  <title>{t.redirect.title}</title>
  <meta http-equiv="refresh" content={`0;url=${defaultPath}`} />
  <script is:inline define:vars={{ base, localeMatchers, defaultPath }}>
    (function () {
      var lang = (navigator.language || '').toLowerCase();
      var target = defaultPath;
      for (var i = 0; i < localeMatchers.length; i++) {
        var entry = localeMatchers[i];
        for (var j = 0; j < entry.match.length; j++) {
          var prefix = entry.match[j];
          if (lang === prefix || lang.indexOf(prefix + '-') === 0) {
            target = entry.path;
            break;
          }
        }
        if (target !== defaultPath) break;
      }
      if (location.pathname !== target) location.replace(target);
    })();
  </script>
  <style>
    body { font-family: system-ui, sans-serif; padding: 2rem; color: #0b1416; }
    a { color: #067c86; }
  </style>
</head>
<body>
  <p>
    {t.redirect.manual}
    {localeConfig.map((l, i) => (
      <>
        {i > 0 && ' · '}
        <a href={localePath(l.code)}>{l.label}</a>
      </>
    ))}
  </p>
</body>
</html>
