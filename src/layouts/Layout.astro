---
import '../styles/global.css';
import type { Locale } from '../i18n/utils';
import { alternateUrls, defaultLocale, localeConfig } from '../i18n/utils';
import type { Translations } from '../i18n/utils';

interface Props {
  locale: Locale;
  t: Translations;
}

const { locale, t } = Astro.props;
const alternates = alternateUrls();
const canonical = alternates[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang={locale}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/images/favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}/images/favicon.png`} type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href={`${base}/images/apple-touch-icon.png`} />
    {localeConfig.map((l) => (
      <link rel="alternate" hreflang={l.hreflang} href={alternates[l.code]} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternates[defaultLocale]} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline async src="https://p.apepite.com/js/pa-Gp8eNjUASG-HSx1qbH08o.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
</head>
<body>
    <slot />
</body>
</html>
